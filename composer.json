{
  "name": "newtalaria/logging",
  "description": "PHP SDK for Talaria logging, error tracking, and optional tracing (Silverstripe-ready)",
  "type": "silverstripe-vendormodule",
  "license": "MIT",
  "keywords": [
    "talaria",
    "logging",
    "error-tracking",
    "silverstripe",
    "monolog"
  ],
  "authors": [
    {
      "name": "Talaria",
      "homepage": "https://newtalaria.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "guzzlehttp/guzzle": "^7.0",
    "monolog/monolog": "^1.25 || ^3.0",
    "psr/log": "^1.0 || ^2.0 || ^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
    "suggest": {
        "silverstripe/framework": "Required for the Silverstripe Monolog / Injector integration (^4.13 || ^5 || ^6; PHP 8.1+)",
        "silverstripe/vendor-plugin": "Enables Silverstripe vendor module discovery",
        "predis/predis": "Wrap with Talaria\\Tracing\\RedisInstrumentation::wrap() for Redis CLIENT spans",
        "ext-redis": "Wrap a \\Redis instance with RedisInstrumentation::wrap() for Redis CLIENT spans",
        "ext-pdo": "Wrap connections with Talaria\\Tracing\\TracingPdo",
        "ext-mysqli": "Use Talaria\\Tracing\\TracingMysqli::query() / execute()"
    },
  "autoload": {
    "psr-4": {
      "Talaria\\": "src/",
      "Talaria\\SilverStripe\\": "silverstripe/src/"
    },
    "exclude-from-classmap": [
      "silverstripe/handlers/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Talaria\\Tests\\": "tests/"
    }
  },
  "extra": {
    "installer-name": "talaria-logging"
  },
  "scripts": {
    "test": "phpunit",
    "test:psr-log-matrix": "bash scripts/test-psr-log-matrix.sh"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable"
}
